# ── Gemini ────────────────────────────────────────────────────

GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-2.5-flash

# ── Embeddings ────────────────────────────────────────────────

# "local" uses sentence-transformers (free, no API key needed)

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Store ──────────────────────────────────────────────

CHROMA_PERSIST_DIR=../vector_store

# ── Knowledge Base ────────────────────────────────────────────

KNOWLEDGE_BASE_DIR=../knowledge_base

# ── Database ──────────────────────────────────────────────────

DATABASE_URL=sqlite:///./screening.db

# ── App ───────────────────────────────────────────────────────

APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret

# Local development + deployed frontend

CORS_ORIGINS=[http://localhost:3000,http://localhost:5173,https://b4-screening.vercel.app](http://localhost:3000,http://localhost:5173,https://b4-screening.vercel.app)

# ── RAG Tuning ────────────────────────────────────────────────

CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5