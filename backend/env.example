# ── LLM Provider ──────────────────────────────────────────────
# Choose one: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic (alternative)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Embeddings ────────────────────────────────────────────────
# "local" uses sentence-transformers (free, no API key needed)
# "openai" uses text-embedding-3-small (costs money)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Store ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=../vector_store

# ── Knowledge Base ────────────────────────────────────────────
KNOWLEDGE_BASE_DIR=../knowledge_base

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./screening.db

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── RAG Tuning ────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
